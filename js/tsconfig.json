{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable"],
    "strict": true,
    "noImplicitAny": false,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "@pot/core",
    "baseUrl": ".",
    "paths": {
      "@pot/core": ["./runtime/src/index.ts"],
      "@pot/core/jsx-runtime": ["./runtime/src/jsx-runtime.ts"],
      "@pot/core/jsx-dev-runtime": ["./runtime/src/jsx-dev-runtime.ts"]
    }
  },
  "include": ["runtime/src", "devtools/src", "../games/*/src"]
}
