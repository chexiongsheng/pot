{
  "name": "pot-js",
  "private": true,
  "version": "0.1.0",
  "description": "pot 的 JS 部分：运行时（打进 com.pot.core）、开发工具（打进 com.pot.devtools）、Dev Server / MCP / CLI",
  "type": "commonjs",
  "bin": {
    "pot": "devserver/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.js && node --expose-gc --test \"test/*.test.js\"",
    "dev": "node devserver/cli.js dev ../games/hello",
    "mcp": "node devserver/cli.js mcp"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.8",
    "cosmokit": "^1.8.1",
    "esbuild": "^0.28.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3"
  }
}
