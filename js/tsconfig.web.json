{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "strict": true,
    "noImplicitAny": false,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["runtime/src/web"]
}
